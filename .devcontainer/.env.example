# Copy this file to .devcontainer/.env and adjust the values below.

# Folder containing your other projects, mounted read-only at /reference.
# Defaults to this repository when unset.
REFERENCE_PROJECTS_DIR=/path/to/your/projects

# Timezone for the container. Defaults to UTC when unset.
# Applied at container start, so changing it needs no image rebuild.
TZ=UTC

# X server the Pharo IDE draws on. Normally inherited from the shell that starts
# the devcontainer, and only worth setting here when that shell has no DISPLAY
# or the IDE should go to a different server. There is no default: an unset
# DISPLAY makes pharo-ui say so, which beats guessing a server that refuses the
# connection. With several sockets in /tmp/.X11-unix, the one your session owns
# is the one owned by your uid.
# DISPLAY=:1

# Where Iceberg keeps its clone of every Metacello dependency, shared by every
# image in the container. Set this to an absolute path on the host to keep the
# clones somewhere you can open, back up or point another tool at; leave it
# unset and they live in a Docker-managed volume the host cannot browse.
#
# Create the directory yourself before starting the container. Docker creates a
# missing bind-mount source as root, and the container writes as uid 1000, so a
# directory it had to create is one Iceberg cannot clone into.
# ICEBERG_REPOSITORIES_DIR=/home/you/pharo-iceberg

# Token the GitHub CLI authenticates with, so gh works without `gh auth login`.
# A fine-grained token scoped to Stargate/Stargate needs read and write on
# Contents and Pull requests, and read on Actions to see CI. Applied at
# container start, so changing it needs no image rebuild.
# GH_TOKEN=github_pat_...
